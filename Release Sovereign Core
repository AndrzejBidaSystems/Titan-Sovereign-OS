using namespace std;

// --- SYSTEM KONFIGURACYJNY AB GLOBAL ---
namespace TitanConfig {
    const string VERSION = "v29.0 Absolute Reliability";
    const double SYSTEM_FEE = 500.0;
    const double EUR_PLN_STABLE = 4.35; // Kurs offline (fallback)
}

// --- GLOBAL ENERGY GRID (HYBRID-LIVE) ---
enum class Fuel { P95, DIESEL, LNG, EV_KWH, H2_KG };

struct EnergyFeed {
    string provider;
    double price;
    string unit;
    string last_update;
};

class EnergyMatrix {
private:
    bool is_online = true; // Flaga symulująca wykrycie internetu

public:
    EnergyFeed get_energy_data(Fuel type) {
        // BAZA DANYCH OFFLINE (Gwarancja działania bez neta)
        static map<Fuel, EnergyFeed> offline_db = {
            {Fuel::DIESEL, {"Offline Cache", 7.10, "l", "2026-05-02"}},
            {Fuel::H2_KG,  {"Offline Cache", 12.50, "kg", "2026-05-02"}},
            {Fuel::EV_KWH, {"Offline Cache", 2.20, "kWh", "2026-05-02"}}
        };

        try {
            if (is_online) {
                // SYMULACJA AKTUALIZACJI NA ŻYWO (Pobieranie przy dostępie do sieci)
                offline_db[Fuel::DIESEL] = {"Live API (Shell)", 7.19, "l", "LIVE NOW"};
                offline_db[Fuel::EV_KWH] = {"Live API (Tesla)", 2.45, "kWh", "LIVE NOW"};
            }
            return offline_db.at(type);
        } catch (...) {
            // OBSŁUGA BŁĘDÓW: Jeśli coś pójdzie nie tak, zwróć bezpieczne dane
            return {"System Recovery", 5.00, "unit", "ERROR_RECOVERY"};
        }
    }
};

// --- ENTERPRISE ANALYTICS CORE ---
struct EnterpriseProfile {
    string vat_id;
    double credit_rating;
    bool tacho_ready;
};

class AB_Titan_Engine {
private:
    EnergyMatrix energy;

public:
    void execute_secure_mission(string client, Fuel fuel, double distance, EnterpriseProfile ep) {
        auto start = chrono::high_resolution_clock::now();

        try {
            // 1. PANCERNA WALIDACJA DANYCH
            if (distance <= 0) throw invalid_argument("DISTANCE_ZERO_OR_NEGATIVE");
            if (ep.credit_rating < 45.0) {
                cout << ">>> [SECURITY BLOCK] Kontrahent niewiarygodny. Transakcja odrzucona." << endl;
                return;
            }

            // 2. POBIERANIE ENERGII (AUTOMATYCZNY UPDATE)
            EnergyFeed ef = energy.get_energy_data(fuel);

            // 3. LOGIKA FINANSOWA (ZABEZPIECZONA)
            double revenue = distance * 5.50 * TitanConfig::EUR_PLN_STABLE;
            double costs = (distance * 0.32 * ef.price) + (distance * 0.90);
            double profit = (revenue - costs) * 0.81;

            auto duration = chrono::duration_cast<chrono::nanoseconds>(chrono::high_resolution_clock::now() - start);

            // --- PROFESJONALNY DASHBOARD B2B ---
            cout << "\n====================================================" << endl;
            cout << "   AB TITAN OS " << TitanConfig::VERSION << endl;
            cout << "====================================================" << endl;
            cout << "KONTRAHENT:      " << client << " | NIP: " << ep.vat_id << endl;
            cout << "ZYSK NETTO:      " << fixed << setprecision(2) << profit << " PLN" << endl;
            cout << "ENERGIA:         " << ef.provider << " (" << ef.price << " / " << ef.unit << ")" << endl;
            cout << "AKTUALIZACJA:    " << ef.last_update << " | STATUS: " << (ef.last_update == "LIVE NOW" ? "ONLINE" : "OFFLINE") << endl;
            cout << "PANCERNE BHP:    " << (ep.tacho_ready ? "SECURE" : "UPGRADE REQUIRED") << endl;
            cout << "CZAS ANALIZY:    " << duration.count() << " ns" << endl;
            cout << "SYSTEM FEE:      " << TitanConfig::SYSTEM_FEE << " PLN / MSC" << endl;
            cout << "====================================================" << endl;

        } catch (const exception& e) {
            cout << ">>> [SYSTEM ERROR HANDLED] " << e.what() << endl;
        }
    }
};

int main() {
    AB_Titan_Engine titan;

    // PRZYKŁAD 1: Klient VIP (Pobierze ceny LIVE jeśli jest net)
    titan.execute_secure_mission("AMAZON_GLOBAL", Fuel::EV_KWH, 1250.0, {"PL1234567890", 95.0, true});

    // PRZYKŁAD 2: Błąd danych (Dystans 0) - System obsłuży błąd bez crashu
    titan.execute_secure_mission("TEST_ERROR", Fuel::DIESEL, 0, {"PL0000000000", 50.0, false});

    return 0;
}
